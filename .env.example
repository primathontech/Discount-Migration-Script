# Copy this file to `.env` and fill in real values.

# --- Shopify (source store) — Stage 1 ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-01
# Custom app must have scopes: read_discounts AND read_customers

# Optional Stage 1 tuning (defaults are fine)
MERCHANT_SLUG=your-store
DISCOUNT_PAGE_SIZE=50
CODE_PAGE_SIZE=100
METAFIELD_PAGE_SIZE=100

# --- OpenStore (target) — Stage 2 ---
OPENSTORE_BASE_URL=https://gkx.gokwik.co
OPENSTORE_MERCHANT_ID=your-os-merchant-mid
# Full cookie header from a logged-in OpenStore dashboard session (must include token=...)
OPENSTORE_COOKIE=cto_bundle=...; token=...
# Optional extra cookies for rotation on heavy runs: OPENSTORE_COOKIE_2, OPENSTORE_COOKIE_3, ...
